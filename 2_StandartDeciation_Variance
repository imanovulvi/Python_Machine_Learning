import numpy as np

# standart devation & variance
# standart kenarlasma: verilen ededler orta qiymetden ne qeder kenarlasir olcmek ucundur

# variance : standart kenarlasmanin kvadratidir.
# variance esasen nede istifade olnur standart kenarlasmada deyerler qarisiq ola biler ona gorede kvadrata qaldirib daha yaxsi reqemlerle islemek ucundur
data=[1,2,3,4,5]
data2=[10,20,30,40,50]

print(np.std(data,ddof=0))#ddof=0 eger 100 sagird var ve onlarin 100 -nun de datasi elimizde varsa isledilir.
#Cunki butun datalar var elimizde . ddof=1 ise 100 sagirdin yanliz 30 neferin datasi varsa standart kenarlasmani bir az yuksek tuturuq
print(np.var(data,ddof=0))
